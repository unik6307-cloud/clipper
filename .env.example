# Database configuration
DATABASE_URL="file:./dev.db"

# Application Environment
NODE_ENV="development"
PORT=3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_NAME="Clipper"

# Session & JWT Secret (Generate 32+ character random string in production)
AUTH_SECRET="your-32-char-random-secret"

# Storage Configuration (AWS S3 or Cloudflare R2)
STORAGE_PROVIDER="mock_s3"
STORAGE_BUCKET_NAME="clipper-private-assets"
STORAGE_REGION="us-east-1"
STORAGE_ENDPOINT="https://s3.us-east-1.amazonaws.com"
STORAGE_ACCESS_KEY_ID="placeholder_access_key"
STORAGE_SECRET_ACCESS_KEY="placeholder_secret_key"

# AI Scoring Service
AI_SCORING_ENGINE="deterministic_v1"
AI_GEMINI_API_KEY=""

# Social Platform Integration Credentials
YOUTUBE_CLIENT_ID=""
YOUTUBE_CLIENT_SECRET=""
META_APP_ID=""
META_APP_SECRET=""
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# Marketplace Payment Provider
PAYMENT_PROVIDER="stripe_marketplace"
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
STRIPE_COMMISSION_PERCENT=15

# Error Monitoring & Telemetry
SENTRY_DSN=""
